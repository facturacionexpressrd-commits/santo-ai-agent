{
  "name": "@santoai/agent",
  "version": "1.0.0",
  "description": "Production-grade omnichannel AI agent for business CRM & messaging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator.d.ts",
      "import": "./dist/orchestrator.mjs",
      "require": "./dist/orchestrator.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.mjs",
      "require": "./dist/tools.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.mjs",
      "require": "./dist/guards.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "tsup src/index.ts src/orchestrator.ts src/tools.ts src/guards.ts src/adapters/index.ts --format cjs,esm --dts --outDir dist",
    "dev": "tsc --watch",
    "test": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "crm",
    "omnichannel",
    "chatbot",
    "orchestrator",
    "llm"
  ],
  "author": "Facturación Express RD",
  "license": "MIT",
  "dependencies": {
    "anthropic": "^0.24.0",
    "zod": "^3.22.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facturacionexpressrd-commits/santo-ai-agent.git"
  }
}
